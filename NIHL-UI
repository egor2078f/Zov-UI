local function tw(obj, props, time)
    local t = ts:Create(obj, TweenInfo.new(time or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function ripple(btn)
    spawn(function()
        local c = Instance.new("ImageLabel")
        c.Name = "Ripple"
        c.Parent = btn
        c.BackgroundColor3 = lib.theme.acc1
        c.BackgroundTransparency = 1
        c.BorderSizePixel = 0
        c.Image = "rbxassetid://266543268"
        c.ImageColor3 = Color3.new(1,1,1)
        c.ImageTransparency = 0.8
        local x, y = mouse.X - btn.AbsolutePosition.X, mouse.Y - btn.AbsolutePosition.Y
        c.Position = UDim2.new(0, x, 0, y)
        local len = btn.AbsoluteSize.X * 1.5
        c.Size = UDim2.new(0, 0, 0, 0)
        tw(c, {Size = UDim2.new(0, len, 0, len), Position = UDim2.new(0, x - len/2, 0, y - len/2), ImageTransparency = 1}, 0.5)
        task.wait(0.5)
        c:Destroy()
    end)
end

local function drag(top, main)
    local dragging, dragInput, dragStart, startPos
    local function update(input)
        local delta = input.Position - dragStart
        tw(main, {Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)}, 0.05)
    end
    top.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    top.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
    end)
    uis.InputChanged:Connect(function(input)
        if input == dragInput and dragging then update(input) end
    end)
end

