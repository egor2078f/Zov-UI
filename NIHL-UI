            -- Button
            function Section:AddButton(BtnConfig)
                local ButtonFrame = Create("TextButton", {
                    Parent = SectionContainer,
                    BackgroundColor3 = Aurora.Settings.Theme.Main,
                    Size = UDim2.new(1, 0, 0, 32),
                    Text = "",
                    AutoButtonColor = false
                })
                Create("UICorner", {Parent = ButtonFrame, CornerRadius = UDim.new(0, 4)})
                Create("UIStroke", {Parent = ButtonFrame, Color = Aurora.Settings.Theme.Stroke, Thickness = 1})

                local BtnText = Create("TextLabel", {
                    Parent = ButtonFrame,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 1, 0),
                    Font = Enum.Font.GothamMedium,
                    Text = BtnConfig.Name,
                    TextColor3 = Aurora.Settings.Theme.Text,
                    TextSize = 14
                })

                -- Premium Check
                if BtnConfig.Premium and not Aurora.Settings.IsPremium then
                    ButtonFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                    BtnText.TextColor3 = Aurora.Settings.Theme.TextDark
                    Create("ImageLabel", {
                        Parent = ButtonFrame,
                        Image = "rbxassetid://3926305904", -- Lock Icon
                        BackgroundTransparency = 1,
                        Size = UDim2.new(0, 20, 0, 20),
                        Position = UDim2.new(1, -25, 0.5, -10),
                        ImageColor3 = Aurora.Settings.Theme.Premium
                    })
                    return
                end

                ButtonFrame.MouseEnter:Connect(function()
                    Tween(ButtonFrame, {BackgroundColor3 = Aurora.Settings.Theme.Stroke})
                end)
                ButtonFrame.MouseLeave:Connect(function()
                    Tween(ButtonFrame, {BackgroundColor3 = Aurora.Settings.Theme.Main})
                end)
                ButtonFrame.MouseButton1Click:Connect(function()
                    if BtnConfig.Callback then BtnConfig.Callback() end
                end)
            end

            -- Toggle
            function Section:AddToggle(ToggleConfig)
                local Toggle = {Value = ToggleConfig.Default or false}
                local Flag = ToggleConfig.Flag or ToggleConfig.Name
                Aurora.Flags[Flag] = Toggle.Value

                local ToggleFrame = Create("TextButton", {
                    Parent = SectionContainer,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 32),
                    Text = "",
                    AutoButtonColor = false
                })

                local Text = Create("TextLabel", {
                    Parent = ToggleFrame,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 0, 0, 0),
                    Size = UDim2.new(0.7, 0, 1, 0),
                    Font = Enum.Font.GothamMedium,
                    Text = ToggleConfig.Name,
                    TextColor3 = Aurora.Settings.Theme.Text,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left
                })

                local Checkbox = Create("Frame", {
                    Parent = ToggleFrame,
                    BackgroundColor3 = Aurora.Settings.Theme.Main,
                    Position = UDim2.new(1, -44, 0.5, -10),
                    Size = UDim2.new(0, 44, 0, 20)
                })
                Create("UICorner", {Parent = Checkbox, CornerRadius = UDim.new(1, 0)})
                
                local Knob = Create("Frame", {
                    Parent = Checkbox,
                    BackgroundColor3 = Aurora.Settings.Theme.Text,
                    Position = UDim2.new(0, 2, 0.5, -8),
                    Size = UDim2.new(0, 16, 0, 16)
                })
                Create("UICorner", {Parent = Knob, CornerRadius = UDim.new(1, 0)})

                -- Logic
                local function UpdateState()
                    Aurora.Flags[Flag] = Toggle.Value
                    if Toggle.Value then
                        Tween(Checkbox, {BackgroundColor3 = Aurora.Settings.Theme.Accent})
                        Tween(Knob, {Position = UDim2.new(1, -18, 0.5, -8)})
                    else
                        Tween(Checkbox, {BackgroundColor3 = Aurora.Settings.Theme.Main})
                        Tween(Knob, {Position = UDim2.new(0, 2, 0.5, -8)})
                    end
                    if ToggleConfig.Callback then ToggleConfig.Callback(Toggle.Value) end
                end
                
                -- Init
                if Toggle.Value then UpdateState() end

                ToggleFrame.MouseButton1Click:Connect(function()
                    if ToggleConfig.Premium and not Aurora.Settings.IsPremium then return end
                    Toggle.Value = not Toggle.Value
                    UpdateState()
                end)
                
                Aurora.Elements[Flag] = {
                    Set = function(val) Toggle.Value = val UpdateState() end
                }
            end

            -- Slider
            function Section:AddSlider(SliderConfig)
                local Slider = {Value = SliderConfig.Default or SliderConfig.Min}
                local Flag = SliderConfig.Flag or SliderConfig.Name
                Aurora.Flags[Flag] = Slider.Value
                
                local SliderFrame = Create("Frame", {
                    Parent = SectionContainer,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 45)
                })
                
                local Label = Create("TextLabel", {
                    Parent = SliderFrame,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 20),
                    Text = SliderConfig.Name,
                    Font = Enum.Font.GothamMedium,
                    TextColor3 = Aurora.Settings.Theme.Text,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left
                })
                
                local ValueLabel = Create("TextLabel", {
                    Parent = SliderFrame,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 20),
                    Text = tostring(Slider.Value),
                    Font = Enum.Font.GothamMedium,
                    TextColor3 = Aurora.Settings.Theme.TextDark,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Right
                })

                local SlideTrack = Create("Frame", {
                    Parent = SliderFrame,
                    BackgroundColor3 = Aurora.Settings.Theme.Main,
                    Position = UDim2.new(0, 0, 0, 30),
                    Size = UDim2.new(1, 0, 0, 6)
                })
                Create("UICorner", {Parent = SlideTrack, CornerRadius = UDim.new(1, 0)})

                local Fill = Create("Frame", {
                    Parent = SlideTrack,
                    BackgroundColor3 = Aurora.Settings.Theme.Accent,
                    Size = UDim2.new(0, 0, 1, 0)
                })
                Create("UICorner", {Parent = Fill, CornerRadius = UDim.new(1, 0)})

                -- Sliding Logic
                local IsSliding = false
                
                local function UpdateVal(input)
                    local SizeX = SlideTrack.AbsoluteSize.X
                    local PosX = SlideTrack.AbsolutePosition.X
                    local InputX = input.Position.X
                    
                    local Percent = math.clamp((InputX - PosX) / SizeX, 0, 1)
                    local NewValue = math.floor(SliderConfig.Min + (SliderConfig.Max - SliderConfig.Min) * Percent)
                    
                    Slider.Value = NewValue
                    ValueLabel.Text = tostring(NewValue)
                    Fill.Size = UDim2.new(Percent, 0, 1, 0)
                    Aurora.Flags[Flag] = NewValue
                    
                    if SliderConfig.Callback then SliderConfig.Callback(NewValue) end
                end

                SlideTrack.InputBegan:Connect(function(input)
                    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                        IsSliding = true
                        UpdateVal(input)
                    end
                end)

                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        IsSliding = false
                    end
                end)
                
                UserInputService.InputChanged:Connect(function(input)
                    if IsSliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        UpdateVal(input)
                    end
                end)

                -- Init Visuals
                local StartPercent = (Slider.Value - SliderConfig.Min) / (SliderConfig.Max - SliderConfig.Min)
                Fill.Size = UDim2.new(StartPercent, 0, 1, 0)
            end

            -- Dropdown
            function Section:AddDropdown(DropConfig)
                local Dropdown = {Open = false, Value = DropConfig.Default}
                local Flag = DropConfig.Flag or DropConfig.Name
                Aurora.Flags[Flag] = Dropdown.Value

                local DropFrame = Create("Frame", {
                    Parent = SectionContainer,
                    BackgroundColor3 = Aurora.Settings.Theme.Main,
                    Size = UDim2.new(1, 0, 0, 32),
                    ClipsDescendants = true
                })
                Create("UICorner", {Parent = DropFrame, CornerRadius = UDim.new(0, 4)})
                Create("UIStroke", {Parent = DropFrame, Color = Aurora.Settings.Theme.Stroke, Thickness = 1})

                local DropButton = Create("TextButton", {
                    Parent = DropFrame,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 32),
                    Text = "",
                    ZIndex = 2
                })

                local Label = Create("TextLabel", {
                    Parent = DropFrame,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 10, 0, 0),
                    Size = UDim2.new(1, -40, 0, 32),
                    Font = Enum.Font.GothamMedium,
                    Text = DropConfig.Name .. ": " .. (DropConfig.Default or "..."),
                    TextColor3 = Aurora.Settings.Theme.Text,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left
                })

                local Arrow = Create("ImageLabel", {
                    Parent = DropFrame,
                    BackgroundTransparency = 1,
                    Image = "rbxassetid://6031091004", -- Arrow
                    Position = UDim2.new(1, -25, 0.5, -6),
                    Size = UDim2.new(0, 12, 0, 12),
                    ImageColor3 = Aurora.Settings.Theme.TextDark
                })

                local ItemContainer = Create("ScrollingFrame", {
                    Parent = DropFrame,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 0, 0, 35),
                    Size = UDim2.new(1, 0, 0, 0), -- Grows
                    ScrollBarThickness = 2,
                    CanvasSize = UDim2.new(0,0,0,0)
                })
                Create("UIListLayout", {Parent = ItemContainer, SortOrder = Enum.SortOrder.LayoutOrder})

                local function RefreshList()
                    -- Clear
                    for _, v in pairs(ItemContainer:GetChildren()) do
                        if v:IsA("TextButton") then v:Destroy() end
                    end
                    
                    for _, option in pairs(DropConfig.Options) do
                        local OptBtn = Create("TextButton", {
                            Parent = ItemContainer,
                            BackgroundColor3 = Aurora.Settings.Theme.Secondary,
                            BackgroundTransparency = 0,
                            Size = UDim2.new(1, 0, 0, 25),
                            Text = option,
                            Font = Enum.Font.Gotham,
                            TextColor3 = Aurora.Settings.Theme.TextDark,
                            TextSize = 13
                        })
                        
                        OptBtn.MouseButton1Click:Connect(function()
                            Dropdown.Value = option
                            Aurora.Flags[Flag] = option
                            Label.Text = DropConfig.Name .. ": " .. option
                            if DropConfig.Callback then DropConfig.Callback(option) end
                            
                            -- Close
                            Dropdown.Open = false
                            Tween(DropFrame, {Size = UDim2.new(1, 0, 0, 32)})
                            Tween(Arrow, {Rotation = 0})
                        end)
                    end
                    
                    ItemContainer.CanvasSize = UDim2.new(0, 0, 0, #DropConfig.Options * 25)
                end

                DropButton.MouseButton1Click:Connect(function()
                    Dropdown.Open = not Dropdown.Open
                    RefreshList()
                    if Dropdown.Open then
                        Tween(DropFrame, {Size = UDim2.new(1, 0, 0, 132)}) -- Max height
                        Tween(Arrow, {Rotation = 180})
                        ItemContainer.Size = UDim2.new(1, 0, 0, 95)
                    else
                        Tween(DropFrame, {Size = UDim2.new(1, 0, 0, 32)})
                        Tween(Arrow, {Rotation = 0})
                    end
                end)
            end

            return Section
        end
        
        return Tab
    end

    -- Initialization
    function Window:SelectTab(Index)
