        Preview.Position = UDim2.new(1, -35, 0.5, -10)
        Preview.BackgroundColor3 = default
        Preview.Parent = HeaderBtn
        Instance.new("UICorner", Preview).CornerRadius = UDim.new(0, 5)
        local PS = Instance.new("UIStroke"); PS.Thickness = 1.5; PS.Color = Theme.Stroke; PS.Parent = Preview

        local Arrow = Instance.new("ImageLabel")
        Arrow.Size = UDim2.new(0, 14, 0, 14)
