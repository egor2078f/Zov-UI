    -- Initial Animation
    MainFrame.Size = UDim2.new(0, 0, 0, 0)
    Tween(MainFrame, {Size = Config.Size or UDim2.new(0, 600, 0, 450)}, 0.5, Enum.EasingStyle.Back)

    return Window
end

