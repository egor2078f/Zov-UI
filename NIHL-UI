                Content.Visible = true
                TweenService:Create(Frame, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(0, 260, 0, 210)}):Play()
                TweenService:Create(Arrow, TweenInfo.new(0.3), {Rotation = 180}):Play()
                TweenService:Create(PS, TweenInfo.new(0.3), {Color = Theme.AccentStart}):Play()
            else
