        HueSlide.BackgroundColor3 = Color3.new(1,1,1)
        HueSlide.BorderSizePixel = 0
        HueSlide.Parent = Hue
        Instance.new("UICorner", HueSlide).CornerRadius = UDim.new(0, 2)

