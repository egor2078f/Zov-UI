                TweenService:Create(Arrow, TweenInfo.new(0.3), {Rotation = 0}):Play()
                TweenService:Create(PS, TweenInfo.new(0.3), {Color = Theme.Stroke}):Play()
                
                task.delay(0.3, function()
                    if not Opened then Content.Visible = false end
                end)
            end
        end)

        Update()
    end

    return Elements
end

return Library
