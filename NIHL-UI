            Instance.new("UICorner", Preview).CornerRadius = UDim.new(0, 5)

            local Content = Instance.new("Frame")
            Content.Size = UDim2.new(1, -12, 0, 100)
            Content.Position = UDim2.new(0, 6, 0, 35)
            Content.BackgroundTransparency = 1
            Content.Parent = Frame

            local SV = Instance.new("TextButton")
            SV.Size = UDim2.new(1, -26, 1, 0)
            SV.BackgroundColor3 = Color3.fromHSV(ColorH, 1, 1)
            SV.AutoButtonColor = false
            SV.Text = ""
            SV.Parent = Content
            Instance.new("UICorner", SV).CornerRadius = UDim.new(0, 6)
            local SatGrad = Instance.new("UIGradient"); SatGrad.Color = ColorSequence.new(Color3.new(1,1,1), Color3.new(1,1,1)); SatGrad.Transparency = NumberSequence.new(0,1); SatGrad.Parent = Instance.new("Frame", SV)
            local ValGrad = Instance.new("UIGradient"); ValGrad.Rotation = -90; ValGrad.Color = ColorSequence.new(Color3.new(0,0,0), Color3.new(0,0,0)); ValGrad.Transparency = NumberSequence.new(0,1);
            local WO = Instance.new("Frame"); WO.Size=UDim2.new(1,0,1,0);WO.BackgroundColor3=Color3.new(1,1,1);WO.Parent=SV;Instance.new("UICorner",WO).CornerRadius=UDim.new(0,6);SatGrad.Parent=WO
            local BO = Instance.new("Frame"); BO.Size=UDim2.new(1,0,1,0);BO.BackgroundColor3=Color3.new(0,0,0);BO.Parent=SV;Instance.new("UICorner",BO).CornerRadius=UDim.new(0,6);ValGrad.Parent=BO

            local Hue = Instance.new("TextButton")
            Hue.Size = UDim2.new(0, 18, 1, 0)
            Hue.Position = UDim2.new(1, -18, 0, 0)
            Hue.AutoButtonColor = false
            Hue.Text = ""
            Hue.Parent = Content
            Instance.new("UICorner", Hue).CornerRadius = UDim.new(0, 6)
            local HueGrad = Instance.new("UIGradient"); HueGrad.Rotation=90; HueGrad.Color=ColorSequence.new{ColorSequenceKeypoint.new(0,Color3.fromHSV(1,1,1)),ColorSequenceKeypoint.new(1,Color3.fromHSV(0,1,1))}; HueGrad.Parent=Hue

            local function Update()
                local color = Color3.fromHSV(ColorH, ColorS, ColorV)
                Preview.BackgroundColor3 = color
                SV.BackgroundColor3 = Color3.fromHSV(ColorH, 1, 1)
                callback(color)
            end

            local dS, dH = false, false
            SV.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dS=true end end)
            Hue.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dH=true end end)
            UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dS=false; dH=false end end)
            UserInputService.InputChanged:Connect(function(i)
                if i.UserInputType==Enum.UserInputType.MouseMovement then
                    if dS then
                        ColorS = math.clamp((i.Position.X-SV.AbsolutePosition.X)/SV.AbsoluteSize.X,0,1)
                        ColorV = 1-math.clamp((i.Position.Y-SV.AbsolutePosition.Y)/SV.AbsoluteSize.Y,0,1)
                        Update()
                    elseif dH then
                        ColorH = 1-math.clamp((i.Position.Y-Hue.AbsolutePosition.Y)/Hue.AbsoluteSize.Y,0,1)
                        Update()
                    end
                end
            end)

            local ToggleBtn = Instance.new("TextButton")
            ToggleBtn.Size = UDim2.new(1,0,0,32)
            ToggleBtn.BackgroundTransparency = 1
            ToggleBtn.Text = ""
            ToggleBtn.Parent = Frame
            ToggleBtn.MouseButton1Click:Connect(function()
                Opened = not Opened
                TweenService:Create(Frame, TweenInfo.new(0.3), {Size = UDim2.new(0, 240, 0, Opened and 145 or 32)}):Play()
            end)
        end

        return Elements
    end

    return Window
end

return Library
