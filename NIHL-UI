            rgbFrame.Position = UDim2.new(0, 0, 0, 170)
            rgbFrame.BackgroundTransparency = 1
            rgbFrame.Parent = picker
            
            local function createRGBInput(name, pos, getVal, setVal)
                local inputFrame = Instance.new("Frame")
                inputFrame.Size = UDim2.new(0.32, -2, 1, 0)
                inputFrame.Position = UDim2.new(pos * 0.33, 0, 0, 0)
                inputFrame.BackgroundColor3 = lib.theme.bg
                inputFrame.Parent = rgbFrame
                Instance.new("UICorner", inputFrame).CornerRadius = UDim.new(0, 6)
                local is = Instance.new("UIStroke"); is.Color = lib.theme.str; is.Parent = inputFrame
                
                local input = Instance.new("TextBox")
                input.Size = UDim2.new(1, 0, 1, 0)
                input.BackgroundTransparency = 1
                input.Text = tostring(math.floor(getVal() * 255))
                input.TextColor3 = lib.theme.txt
                input.Font = lib.theme.f1
                input.TextSize = 12
                input.Parent = inputFrame
                
                input.FocusLost:Connect(function()
                    local num = tonumber(input.Text) or 0
                    num = math.clamp(num, 0, 255)
                    setVal(num / 255)
                    col = Color3.new(math.clamp(tonumber(rgbFrame:FindFirstChild("R").TextBox.Text)/255,0,1), math.clamp(tonumber(rgbFrame:FindFirstChild("G").TextBox.Text)/255,0,1), math.clamp(tonumber(rgbFrame:FindFirstChild("B").TextBox.Text)/255,0,1))
                    h, s, v = rgbToHsv(col)
                    prev.BackgroundColor3 = col
                    hueGrad.Color = ColorSequence.new(hsvToRgb(h, 1, 1))
                    svCursor.Position = UDim2.new(s, -7, 1 - v, -7)
                    hueCursor.Position = UDim2.new(0, -2, h / 360, -2)
                    cb(col)
                end)
                inputFrame.Name = name; input.Name = "TextBox"
                return input
            end
            
            local rInput = createRGBInput("R", 0, function() return col.R end, function(val) col = Color3.new(val, col.G, col.B) end)
