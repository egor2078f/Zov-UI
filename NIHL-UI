            TweenService:Create(S, TweenInfo.new(0.5), {Color = Theme.Stroke}):Play()
            callback()
        end)
    end

    function Elements:ColorPicker(text, default, callback)
        local Opened = false
        local ColorH, ColorS, ColorV = default:ToHSV()
        
        local Frame = Instance.new("Frame")
        Frame.Name = "ColorPicker"
        Frame.Size = UDim2.new(0, 260, 0, 38)
        Frame.BackgroundColor3 = Theme.SectionColor
        Frame.ClipsDescendants = true 
        Frame.Parent = Container
        
        local C = Instance.new("UICorner"); C.CornerRadius = Theme.CornerRadius; C.Parent = Frame
        local S = Instance.new("UIStroke"); S.Thickness = 1; S.Color = Theme.Stroke; S.Parent = Frame

        local HeaderBtn = Instance.new("TextButton")
