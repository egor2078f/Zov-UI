        Content.BackgroundTransparency = 1
        Content.Visible = false
        Content.Parent = Frame

        local SV = Instance.new("TextButton")
        SV.Text = ""
        SV.Size = UDim2.new(1, -26, 0, 120)
        SV.BackgroundColor3 = Color3.fromHSV(ColorH, 1, 1)
        SV.AutoButtonColor = false
        SV.Parent = Content
        Instance.new("UICorner", SV).CornerRadius = UDim.new(0, 6)
        
        local SatGrad = Instance.new("UIGradient")
        SatGrad.Color = ColorSequence.new(Color3.new(1,1,1), Color3.new(1,1,1))
        SatGrad.Transparency = NumberSequence.new(0, 1)
        SatGrad.Parent = Instance.new("Frame", SV)
        local ValGrad = Instance.new("UIGradient")
        ValGrad.Rotation = -90
        ValGrad.Color = ColorSequence.new(Color3.new(0,0,0), Color3.new(0,0,0))
        ValGrad.Transparency = NumberSequence.new(0, 1)
        
        local WhiteOverlay = Instance.new("Frame"); WhiteOverlay.Size = UDim2.new(1,0,1,0); WhiteOverlay.BackgroundColor3 = Color3.new(1,1,1); WhiteOverlay.Parent = SV; Instance.new("UICorner", WhiteOverlay).CornerRadius = UDim.new(0, 6); SatGrad.Parent = WhiteOverlay
        local BlackOverlay = Instance.new("Frame"); BlackOverlay.Size = UDim2.new(1,0,1,0); BlackOverlay.BackgroundColor3 = Color3.new(0,0,0); BlackOverlay.Parent = SV; Instance.new("UICorner", BlackOverlay).CornerRadius = UDim.new(0, 6); ValGrad.Parent = BlackOverlay

        local PickerDot = Instance.new("Frame")
