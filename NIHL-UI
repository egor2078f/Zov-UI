            local satOverlay = Instance.new("Frame"); satOverlay.Size = UDim2.new(1,0,1,0); satOverlay.BackgroundColor3 = Color3.new(1,1,1); satOverlay.Parent = svFrame
            Instance.new("UICorner", satOverlay).CornerRadius = UDim.new(0, 8)
            local satGrad = Instance.new("UIGradient"); satGrad.Color = ColorSequence.new{ColorSequenceKeypoint.new(0,Color3.new(1,1,1)),ColorSequenceKeypoint.new(1,Color3.new(1,1,1))}; satGrad.Transparency = NumberSequence.new{NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(1,1)}; satGrad.Parent = satOverlay
            
