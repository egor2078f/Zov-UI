        function el:DualLabel(txt1, txt2)
            local f = Instance.new("Frame")
            f.Size = UDim2.new(0, 240, 0, 20)
            f.BackgroundTransparency = 1
            f.Parent = pg
            
            local l1 = Instance.new("TextLabel")
            l1.Text = txt1
            l1.Font = lib.theme.f1
            l1.TextColor3 = lib.theme.dim
            l1.TextSize = 13
            l1.Size = UDim2.new(0.5, 0, 1, 0)
            l1.TextXAlignment = Enum.TextXAlignment.Left
            l1.BackgroundTransparency = 1
            l1.Parent = f
            Instance.new("UIPadding", l1).PaddingLeft = UDim.new(0, 5)
            
            local l2 = Instance.new("TextLabel")
            l2.Text = txt2
            l2.Font = lib.theme.f2
            l2.TextColor3 = lib.theme.acc1
            l2.TextSize = 13
            l2.Size = UDim2.new(0.5, 0, 1, 0)
            l2.Position = UDim2.new(0.5, 0, 0, 0)
            l2.TextXAlignment = Enum.TextXAlignment.Right
            l2.BackgroundTransparency = 1
            l2.Parent = f
            Instance.new("UIPadding", l2).PaddingRight = UDim.new(0, 5)
            
            return {
                Update = function(t1, t2)
                    if t1 then l1.Text = t1 end
                    if t2 then l2.Text = t2 end
                end
            }
        end

        return el
    end
    return win_funcs
end
return lib
