            local bInput = createRGBInput("B", 2, function() return col.B end, function(val) col = Color3.new(col.R, col.G, val) end)
            
            -- Interaction Logic
            local svDragging = false
            svFrame.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then svDragging = true end end)
