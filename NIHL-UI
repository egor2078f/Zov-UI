                Size = UDim2.new(0, 130, 0, 25),
                BackgroundColor3 = Library.Theme.Main,
                Text = ToHex(ColorValue),
                TextColor3 = Library.Theme.Text,
                Font = Library.Theme.Font,
                TextSize = 12,
                PlaceholderText = "HEX"
            })
            Create("UICorner", {Parent = HexInput, CornerRadius = UDim.new(0, 4)})
            
            local RInput = Create("TextBox", { Parent = Container, Position = UDim2.new(1, -140, 0, 30), Size = UDim2.new(0, 40, 0, 25), BackgroundColor3 = Library.Theme.Main, Text = math.floor(ColorValue.R*255), TextColor3 = Color3.fromRGB(255,100,100), Font=Library.Theme.Font, TextSize=12 })
            Create("UICorner", {Parent=RInput, CornerRadius=UDim.new(0,4)})
            local GInput = Create("TextBox", { Parent = Container, Position = UDim2.new(1, -95, 0, 30), Size = UDim2.new(0, 40, 0, 25), BackgroundColor3 = Library.Theme.Main, Text = math.floor(ColorValue.G*255), TextColor3 = Color3.fromRGB(100,255,100), Font=Library.Theme.Font, TextSize=12 })
            Create("UICorner", {Parent=GInput, CornerRadius=UDim.new(0,4)})
            local BInput = Create("TextBox", { Parent = Container, Position = UDim2.new(1, -50, 0, 30), Size = UDim2.new(0, 40, 0, 25), BackgroundColor3 = Library.Theme.Main, Text = math.floor(ColorValue.B*255), TextColor3 = Color3.fromRGB(100,100,255), Font=Library.Theme.Font, TextSize=12 })
            Create("UICorner", {Parent=BInput, CornerRadius=UDim.new(0,4)})
            
            local AlphaBar = Create("TextButton", {
                Parent = Container,
                Position = UDim2.new(0, 12, 0, 190),
                Size = UDim2.new(0, 215, 0, 20),
                BackgroundColor3 = Color3.new(1,1,1),
                Text = "",
                AutoButtonColor = false
            })
            Create("UICorner", {Parent = AlphaBar, CornerRadius = UDim.new(0, 4)})
            Create("ImageLabel", {Parent=AlphaBar, Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Image="rbxassetid://14454942007", ScaleType=Enum.ScaleType.Tile, TileSize=UDim2.new(0,10,0,10)})
            local AlphaGrad = Create("Frame", {Parent=AlphaBar, Size=UDim2.new(1,0,1,0), BackgroundColor3=Color3.new(1,1,1), ZIndex=2})
            Create("UICorner", {Parent=AlphaGrad, CornerRadius=UDim.new(0,4)})
            local AlphaUIGrad = Create("UIGradient", {Parent=AlphaGrad, Transparency=NumberSequence.new{NumberSequenceKeypoint.new(0,0), NumberSequenceKeypoint.new(1,1)}})
            
            local AlphaCursor = Create("Frame", {
                Parent = AlphaBar,
                Size = UDim2.new(0, 4, 1, 4),
                Position = UDim2.new(0, 0, 0, -2),
                BackgroundColor3 = Color3.new(1,1,1),
                BorderColor3 = Color3.new(0,0,0),
                BorderSizePixel = 1,
                ZIndex = 3
            })

            -- Logic
            local function UpdateColor()
                ColorValue = Color3.fromHSV(H, S, V)
                
                SVBox.BackgroundColor3 = Color3.fromHSV(H, 1, 1)
                PreviewBox.BackgroundColor3 = ColorValue
                PreviewBox.BackgroundTransparency = Alpha
                AlphaGrad.BackgroundColor3 = ColorValue
                
                HexInput.Text = ToHex(ColorValue)
                RInput.Text = math.floor(ColorValue.R * 255)
                GInput.Text = math.floor(ColorValue.G * 255)
                BInput.Text = math.floor(ColorValue.B * 255)
                
                if callback then callback(ColorValue, Alpha) end
            end
            
            -- Dragging Logic
            local draggingSV, draggingHue, draggingAlpha = false, false, false
            
            SVBox.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSV = true end
            end)
            HueBox.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingHue = true end
            end)
            AlphaBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingAlpha = true end
            end)
            
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingSV, draggingHue, draggingAlpha = false, false, false
                end
            end)
            
            RunService.RenderStepped:Connect(function()
                local Mouse = UserInputService:GetMouseLocation()
                
                if draggingSV then
                    local rX = math.clamp(Mouse.X - SVBox.AbsolutePosition.X, 0, SVBox.AbsoluteSize.X)
                    local rY = math.clamp(Mouse.Y - SVBox.AbsolutePosition.Y - 36, 0, SVBox.AbsoluteSize.Y) -- -36 accounts for GuiInset usually, adjust if needed
                    S = rX / SVBox.AbsoluteSize.X
                    V = 1 - (rY / SVBox.AbsoluteSize.Y)
                    SVCursor.Position = UDim2.new(S, -5, 1-V, -5)
                    UpdateColor()
                end
                
                if draggingHue then
                    local rY = math.clamp(Mouse.Y - HueBox.AbsolutePosition.Y - 36, 0, HueBox.AbsoluteSize.Y)
                    H = rY / HueBox.AbsoluteSize.Y
                    HueCursor.Position = UDim2.new(0, -2, H, -3)
                    UpdateColor()
                end
                
                if draggingAlpha then
                    local rX = math.clamp(Mouse.X - AlphaBar.AbsolutePosition.X, 0, AlphaBar.AbsoluteSize.X)
                    Alpha = rX / AlphaBar.AbsoluteSize.X
                    AlphaCursor.Position = UDim2.new(Alpha, -2, 0, -2)
                    UpdateColor()
                end
            end)
            
            -- Manual Inputs
            HexInput.FocusLost:Connect(function()
                local s, color = pcall(FromHex, HexInput.Text)
                if s then
                    ColorValue = color
                    H, S, V = RGBToHSV(ColorValue)
                    SVBox.BackgroundColor3 = Color3.fromHSV(H, 1, 1)
                    SVCursor.Position = UDim2.new(S, -5, 1-V, -5)
                    HueCursor.Position = UDim2.new(0, -2, H, -3)
                    UpdateColor()
                end
            end)
            
            -- Toggle Open
            PreviewBox.MouseButton1Click:Connect(function()
                IsOpen = not IsOpen
                Container.Visible = IsOpen
                Tween(PickerFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Size = UDim2.new(1, 0, 0, IsOpen and 265 or 36)
                })
            end)
        end
        
        function Tab:Dropdown(text, options, callback)
            local DropdownFrame = Create("Frame", {
                Parent = TabPage,
                BackgroundColor3 = Library.Theme.Secondary,
                Size = UDim2.new(1, 0, 0, 36),
                ClipsDescendants = true
            })
            Create("UICorner", {Parent = DropdownFrame, CornerRadius = UDim.new(0, 6)})
            Create("UIStroke", {Parent = DropdownFrame, Color = Library.Theme.Stroke, Thickness = 1})
            
            local Label = Create("TextLabel", {
                Parent = DropdownFrame,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 12, 0, 0),
                Size = UDim2.new(1, -40, 0, 36),
                Font = Library.Theme.Font,
                Text = text,
                TextColor3 = Library.Theme.Text,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left
            })
            
            local Icon = Create("ImageLabel", {
                Parent = DropdownFrame,
                BackgroundTransparency = 1,
                Position = UDim2.new(1, -28, 0, 10),
                Size = UDim2.new(0, 16, 0, 16),
                Image = "rbxassetid://6031091004",
                ImageColor3 = Library.Theme.TextDark
            })
            
            local Button = Create("TextButton", {
                Parent = DropdownFrame,
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 36),
                Text = ""
            })
            
            local OptionContainer = Create("Frame", {
                Parent = DropdownFrame,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 0, 0, 40),
                Size = UDim2.new(1, 0, 0, 0)
            })
            local OptionList = Create("UIListLayout", {Parent = OptionContainer, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4)})
            Create("UIPadding", {Parent = OptionContainer, PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8)})
            
            local IsOpen = false
            
            Button.MouseButton1Click:Connect(function()
                IsOpen = not IsOpen
                local height = IsOpen and (44 + (#options * 28)) or 36
                Tween(DropdownFrame, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 0, height)})
                Tween(Icon, TweenInfo.new(0.3), {Rotation = IsOpen and 180 or 0})
            end)
            
            for _, opt in ipairs(options) do
                local OptBtn = Create("TextButton", {
                    Parent = OptionContainer,
                    BackgroundColor3 = Library.Theme.Main,
                    Size = UDim2.new(1, 0, 0, 24),
                    Font = Library.Theme.Font,
                    Text = opt,
                    TextColor3 = Library.Theme.TextDark,
                    TextSize = 12,
                    AutoButtonColor = false
                })
                Create("UICorner", {Parent = OptBtn, CornerRadius = UDim.new(0, 4)})
                
                OptBtn.MouseButton1Click:Connect(function()
                    Label.Text = text .. ": " .. opt
                    callback(opt)
                    IsOpen = false
                    Tween(DropdownFrame, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 0, 36)})
                    Tween(Icon, TweenInfo.new(0.3), {Rotation = 0})
                end)
                
                OptBtn.MouseEnter:Connect(function() Tween(OptBtn, TweenInfo.new(0.2), {TextColor3 = Library.Theme.Accent, BackgroundTransparency = 0.5}) end)
                OptBtn.MouseLeave:Connect(function() Tween(OptBtn, TweenInfo.new(0.2), {TextColor3 = Library.Theme.TextDark, BackgroundTransparency = 0}) end)
            end
        end

        function Tab:Keybind(text, default, callback)
            local bind = default or Enum.KeyCode.RightShift
            local waiting = false
            
            local Frame = Create("Frame", {
                Parent = TabPage,
                BackgroundColor3 = Library.Theme.Secondary,
                Size = UDim2.new(1, 0, 0, 36)
            })
            Create("UICorner", {Parent = Frame, CornerRadius = UDim.new(0, 6)})
            Create("UIStroke", {Parent = Frame, Color = Library.Theme.Stroke, Thickness = 1})
            
            local Label = Create("TextLabel", {
                Parent = Frame,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 12, 0, 0),
                Size = UDim2.new(1, -100, 1, 0),
                Font = Library.Theme.Font,
                Text = text,
                TextColor3 = Library.Theme.Text,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left
            })
            
            local BindBtn = Create("TextButton", {
                Parent = Frame,
                BackgroundColor3 = Library.Theme.Main,
                Position = UDim2.new(1, -90, 0.5, -10),
                Size = UDim2.new(0, 80, 0, 20),
                Font = Library.Theme.FontBold,
                Text = bind.Name,
                TextColor3 = Library.Theme.TextDark,
                TextSize = 11
            })
            Create("UICorner", {Parent = BindBtn, CornerRadius = UDim.new(0, 4)})
            
            BindBtn.MouseButton1Click:Connect(function()
                waiting = true
                BindBtn.Text = "..."
                BindBtn.TextColor3 = Library.Theme.Accent
            end)
            
            UserInputService.InputBegan:Connect(function(input)
                if waiting and input.UserInputType == Enum.UserInputType.Keyboard then
                    waiting = false
                    bind = input.KeyCode
                    BindBtn.Text = bind.Name
                    BindBtn.TextColor3 = Library.Theme.TextDark
                elseif input.KeyCode == bind then
                    if callback then callback() end
                end
            end)
        end
        
        return Tab
    end
    
    return Window
end

return Library
