            local gBox = mkRGB("G", function() return col.G end, function(x) col = Color3.new(col.R, x, col.B) end)
            local bBox = mkRGB("B", function() return col.B end, function(x) col = Color3.new(col.R, col.G, x) end)
            
            prev.MouseButton1Click:Connect(function()
                open = not open
                tw(f, {Size = UDim2.new(0, 380, 0, open and 240 or 36)})
            end)
        end
        
        function el:Dropdown(txt, options, cb)
            local f = Instance.new("Frame")
            f.Size = UDim2.new(0, 380, 0, 36)
            f.BackgroundColor3 = lib.theme.sec
            f.Parent = pg
            f.ClipsDescendants = true
            Instance.new("UICorner", f).CornerRadius = lib.theme.cr
            Instance.new("UIStroke", f).Color = lib.theme.str
            
            local l = Instance.new("TextLabel")
            l.Text = txt
            l.Size = UDim2.new(1, -40, 0, 36)
            l.Position = UDim2.new(0, 12, 0, 0)
            l.BackgroundTransparency = 1
            l.Font = lib.theme.f1
            l.TextColor3 = lib.theme.txt
            l.TextXAlignment = Enum.TextXAlignment.Left
            l.TextSize = 13
            l.Parent = f
            
            local ico = Instance.new("ImageLabel")
            ico.Size = UDim2.new(0, 16, 0, 16)
            ico.Position = UDim2.new(1, -26, 0, 10)
            ico.BackgroundTransparency = 1
            ico.Image = "rbxassetid://6031091004"
            ico.ImageColor3 = lib.theme.dim
            ico.Parent = f
            
            local c = Instance.new("Frame")
            c.Size = UDim2.new(1, -24, 0, 0)
            c.Position = UDim2.new(0, 12, 0, 40)
            c.BackgroundTransparency = 1
            c.Parent = f
            local clist = Instance.new("UIListLayout"); clist.Padding=UDim.new(0,4); clist.Parent=c
            
            for _, o in ipairs(options) do
                local b = Instance.new("TextButton")
                b.Size = UDim2.new(1, 0, 0, 26)
                b.BackgroundColor3 = lib.theme.bg
                b.Text = o
                b.Font = lib.theme.f1
                b.TextColor3 = lib.theme.dim
                b.TextSize = 13
                b.Parent = c
                Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
                b.MouseButton1Click:Connect(function()
                    l.Text = txt..": "..o
                    cb(o)
                    tw(f, {Size = UDim2.new(0, 380, 0, 36)})
                    tw(ico, {Rotation = 0})
                end)
            end
            
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 36)
            btn.BackgroundTransparency = 1
            btn.Text = ""
            btn.Parent = f
            local open = false
            btn.MouseButton1Click:Connect(function()
                open = not open
                tw(f, {Size = UDim2.new(0, 380, 0, open and (45 + (#options * 30)) or 36)})
                tw(ico, {Rotation = open and 180 or 0})
            end)
        end

        function el:Input(txt, ph, cb)
            local f = Instance.new("Frame")
            f.Size = UDim2.new(0, 380, 0, 36)
            f.BackgroundColor3 = lib.theme.sec
            f.Parent = pg
            Instance.new("UICorner", f).CornerRadius = lib.theme.cr
            Instance.new("UIStroke", f).Color = lib.theme.str
            
            local l = Instance.new("TextLabel")
            l.Text = txt
            l.Size = UDim2.new(0, 100, 1, 0)
            l.Position = UDim2.new(0, 12, 0, 0)
            l.BackgroundTransparency = 1
            l.Font = lib.theme.f1
            l.TextColor3 = lib.theme.txt
            l.TextXAlignment = Enum.TextXAlignment.Left
            l.TextSize = 13
            l.Parent = f
            
            local b = Instance.new("TextBox")
            b.Size = UDim2.new(0, 120, 0, 24)
            b.Position = UDim2.new(1, -132, 0.5, -12)
            b.BackgroundColor3 = lib.theme.bg
            b.TextColor3 = lib.theme.txt
            b.PlaceholderText = ph
            b.PlaceholderColor3 = lib.theme.dim
            b.Font = lib.theme.f1
            b.TextSize = 12
            b.Parent = f
            Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
            
            b.FocusLost:Connect(function() cb(b.Text) end)
        end

        return el
    end
    return tabs
end

return lib
