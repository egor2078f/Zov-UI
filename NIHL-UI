        task.wait(0.3)
        ScreenGui:Destroy()
    end)

    local minimized = false
    local containerRef = nil

    CreateControlBtn("−", 2, function()
        minimized = not minimized
        if minimized then
            if containerRef then containerRef.Visible = false end
            GlowLine.Visible = false
            TweenService:Create(Main, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(0, 280, 0, 45)}):Play()
        else
            TweenService:Create(Main, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(0, 280, 0, 350)}):Play()
            task.wait(0.2)
